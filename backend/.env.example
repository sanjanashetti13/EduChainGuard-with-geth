PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/
MONGO_DB_NAME=educhain
JWT_SECRET=replace_with_a_long_random_string

# Blockchain (CertificateStorage on Polygon Amoy — required for upload/verify)
CONTRACT_ADDRESS=
WALLET_ADDRESS=
PRIVATE_KEY=
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology

# Google OAuth (optional — set to match frontend GoogleOAuthProvider client id)
GOOGLE_CLIENT_ID=
# Set to false to turn off Google routes (manual auth still works)
GOOGLE_AUTH_ENABLED=true

# Pinata IPFS (optional — for POST /upload-to-pinata standalone uploads)
# Prefer JWT from https://app.pinata.cloud/developers/api-keys — uploads use Pinata V3
# (https://uploads.pinata.cloud/v3/files). Legacy pinning is fallback for older keys.
PINATA_JWT=
PINATA_API_KEY=
PINATA_SECRET_API_KEY=
# Optional: custom gateway base, e.g. https://my-gateway.mypinata.cloud or https://gateway.pinata.cloud/ipfs
PINATA_GATEWAY_URL=
